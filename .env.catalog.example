# Use the same R2 bucket and credentials as invite-me v2.
# Keep real credentials only in your local .env or deployment environment.
CATALOG_UPLOAD_DISK=catalog_cloud
CATALOG_S3_KEY=
CATALOG_S3_SECRET=
CATALOG_S3_REGION=auto
CATALOG_S3_BUCKET=
CATALOG_S3_ENDPOINT=
CATALOG_S3_URL=

# Optional: read-only PostgreSQL source for migrating actual old catalog data.
INVITE_DATABASE_URL=
