{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "",
    "buildCommand": "",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 60
        }
    },
    "routes": [
        { "src": "/(?:index\\.php)?", "dest": "/api/index.php" },
        { "src": "/.*\\.php$", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "FORCE_HTTPS": "true",
        "LOG_CHANNEL": "stderr",
        "SESSION_SECURE_COOKIE": "true",
        "LARAVEL_STORAGE_PATH": "/tmp/coignitive-membership/storage",
        "APP_CONFIG_CACHE": "/tmp/coignitive-membership/bootstrap/cache/config.php",
        "APP_EVENTS_CACHE": "/tmp/coignitive-membership/bootstrap/cache/events.php",
        "APP_PACKAGES_CACHE": "/tmp/coignitive-membership/bootstrap/cache/packages.php",
        "APP_ROUTES_CACHE": "/tmp/coignitive-membership/bootstrap/cache/routes.php",
        "APP_SERVICES_CACHE": "/tmp/coignitive-membership/bootstrap/cache/services.php",
        "VIEW_COMPILED_PATH": "/tmp/coignitive-membership/storage/framework/views"
    }
}
